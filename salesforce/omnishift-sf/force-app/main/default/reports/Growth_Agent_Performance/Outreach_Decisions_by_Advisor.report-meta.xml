<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <chartSummaries>
            <axisBinding>y</axisBinding>
            <column>RowCount</column>
        </chartSummaries>
        <chartType>HorizontalBarStacked</chartType>
        <enableHoverLabels>true</enableHoverLabels>
        <expandOthers>true</expandOthers>
        <groupingColumn>Lead.Omnishift_Recommended_Owner__c</groupingColumn>
        <legendPosition>Right</legendPosition>
        <location>CHART_TOP</location>
        <secondaryGroupingColumn>Lead.Omnishift_Disposition__c</secondaryGroupingColumn>
        <showAxisLabels>true</showAxisLabels>
        <showValues>false</showValues>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <title>What each advisor did with their queue</title>
    </chart>
    <columns>
        <field>Lead.Omnishift_Rank__c</field>
    </columns>
    <columns>
        <field>LAST_NAME</field>
    </columns>
    <description>Each advisor's queue broken out by what they actually did. The blank column is the part of the queue nobody touched - that is the adoption number, and it is the one that decides whether any of the rest matters.</description>
    <filter>
        <criteriaItems>
            <column>Lead.Omnishift_Rank__c</column>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>Lead.Omnishift_Disposition__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Lead.Omnishift_Recommended_Owner__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Outreach Decisions by Advisor</name>
    <reportType>LeadList</reportType>
    <scope>org</scope>
    <showDetails>false</showDetails>
</Report>
